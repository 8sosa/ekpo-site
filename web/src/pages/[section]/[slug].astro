---
import Layout from '../../layouts/Layout.astro'
import Crumbs from '../../components/Crumbs.astro'
import Card from '../../components/Card.astro'
import Media from '../../components/Media.astro'
import {getSite, U, fmtDate, readTime, initials, type Article} from '../../lib/data'
import {renderBody} from '../../lib/portableText'
import {SOCIAL_ICONS} from '../../components/Icons'

export async function getStaticPaths() {
  const site = await getSite()
  return site.articles.map((article) => ({params: {section: article.section, slug: article.slug}, props: {article}}))
}
interface Props { article: Article }
const {article: a} = Astro.props
const site = await getSite()
const s = site.section(a.section)!
const same = site.inSection(a.section)
const i = same.indexOf(a)
const newer = same[i - 1], older = same[i + 1]
const latest = site.articles.filter((x) => x !== a).slice(0, 5)
const more = same.filter((x) => x !== a).slice(0, 3)
const url = new URL(Astro.url.pathname, Astro.site).href
const u = encodeURIComponent(url), t = encodeURIComponent(a.title)
---
<Layout title={a.title} description={a.excerpt} image={a.mainImage} type="article" page="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={a.publishedAt} />
    <meta property="article:section" content={a.sectionName} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'NewsArticle', headline: a.title, description: a.excerpt,
      datePublished: a.publishedAt, author: {'@type': 'Person', name: a.writer.name, url: new URL(U.writer(a.writer.slug), Astro.site).href},
      publisher: {'@type': 'Organization', name: 'EKPO'}, mainEntityOfPage: url,
    })} />
  </Fragment>
  <article>
    <header class="art-head">
      <Crumbs items={[['Home', '/'], [s.name, U.section(s.slug)], [a.topic.name, U.topic(s.slug, a.topic.slug)]]} />
      <h1>{a.title}</h1>
      <p class="dek">{a.excerpt}</p>
      <p class="byline">
        <span>By <a href={U.writer(a.writer.slug)}>{a.writer.name}</a></span>
        <time datetime={a.publishedAt}>{fmtDate(a.publishedAt)}</time>
        <span>{readTime(a)}</span>
      </p>
    </header>
    <div class="art-hero"><div class="img"><Media image={a.mainImage} seed={a.seed} w={1600} h={900} eager /></div></div>
    <div class="art-layout">
      <aside class="share" aria-label="Share this story"><small>Share</small>
        <a href={`https://twitter.com/intent/tweet?url=${u}&text=${t}`} target="_blank" rel="noopener" aria-label="Share on X" set:html={SOCIAL_ICONS.x} />
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${u}`} target="_blank" rel="noopener" aria-label="Share on Facebook" set:html={SOCIAL_ICONS.facebook} />
        <a href={`https://wa.me/?text=${t}%20${u}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp" set:html={SOCIAL_ICONS.whatsapp} />
        <a href={`mailto:?subject=${t}&body=${u}`} aria-label="Share by email"><svg class="stroke" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" /><path d="M3 6l9 7 9-7" /></svg></a>
        <button type="button" class="copy-link" aria-label="Copy link"><svg class="stroke" viewBox="0 0 24 24"><path d="M10 14a4 4 0 006 0l3-3a4 4 0 00-6-6l-1 1M14 10a4 4 0 00-6 0l-3 3a4 4 0 006 6l1-1" /></svg></button>
      </aside>
      <div class="prose" set:html={renderBody(a.body)} />
      <aside class="art-aside"><h2>Latest on EKPO</h2><ol>{latest.map((x) => <li><a href={x.url}>{x.title}</a></li>)}</ol></aside>
    </div>
    <div class="art-foot"><div>
      <div class="tagrow"><a href={U.section(s.slug)}>{s.name}</a><a href={U.topic(s.slug, a.topic.slug)}>{a.topic.name}</a></div>
      <div class="author-box">
        <div class="avatar" aria-hidden="true">{a.writer.photo?.asset ? <Media image={a.writer.photo} seed={1} w={144} h={144} /> : initials(a.writer.name)}</div>
        <div><h3>{a.writer.name}</h3><p>{a.writer.bio}</p><a class="more" href={U.writer(a.writer.slug)}>More from {a.writer.name.split(' ')[0]}</a></div>
      </div>
      <nav class="pager" aria-label={`More in ${s.name}`}>
        {older && <a href={older.url}><small>Previous</small><span>{older.title}</span></a>}
        {newer && <a class="next" href={newer.url}><small>Next</small><span>{newer.title}</span></a>}
      </nav>
    </div></div>
  </article>
  {more.length > 0 && (
    <section class="sec band"><div class="wrap">
      <div class="sec-head"><h2>More {s.name}</h2></div>
      <div class="l-3">{more.map((x) => <Card a={x} />)}</div>
      <a class="view-more" href={U.section(s.slug)}>View more {s.name}</a>
    </div></section>
  )}
</Layout>

<script>
  import {$, toast} from '../../scripts/core'

  $('.copy-link')?.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(location.href); toast('Link copied.') }
    catch { prompt('Copy this link:', location.href) }
  })

  /* reading progress bar */
  const bar = $('#progress')!, prose = $('.prose')!
  bar.hidden = false
  const update = () => {
    const r = prose.getBoundingClientRect()
    bar.style.width = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight + 200))) * 100 + '%'
  }
  addEventListener('scroll', update, {passive: true})
  update()
</script>
