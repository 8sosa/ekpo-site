---
import Layout from '../layouts/Layout.astro'
import PageHead from './PageHead.astro'
import ProductCard from './ProductCard.astro'
import {getSite, U} from '../lib/data'

interface Props { category?: string }
const {category} = Astro.props
const site = await getSite()
const list = site.products.filter((p) => !category || p.category === category)
---
<Layout title={category ? `${category} | Shop` : 'Shop'} description="Print issues, tickets and pieces made with the Nigerian brands we cover. Delivery across Nigeria." nav="shop" page="shop">
  <PageHead crumbs={category ? [['Home', '/'], ['Shop', '/shop/'], [category]] : [['Home', '/'], ['Shop']]} title="The EKPO store" lede="Print issues, tickets and pieces made with the Nigerian brands we cover. Delivery across Nigeria.">
    <nav class="chips" aria-label="Shop categories">
      <a href="/shop/" aria-current={!category ? 'true' : 'false'}>All</a>
      {site.shopCategories.map((c) => <a href={U.shopCat(c)} aria-current={c === category ? 'true' : 'false'}>{c}</a>)}
    </nav>
  </PageHead>
  <div class="page-body"><div class="wrap">
    {list.length ? <div class="shop-grid">{list.map((p) => <ProductCard p={p} />)}</div> : <p class="empty">Nothing here yet.</p>}
  </div></div>
</Layout>
